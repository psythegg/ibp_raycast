{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ibp-booking",
  "title": "IBP Booking",
  "description": "This extension is made for booking IBP Lounge (Room 112 in Edu Building).",
  "icon": "extension-icon.png",
  "author": "sithuaung_eric",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "book-lounge",
      "title": "Book Lounge",
      "description": "Book the IBP Lounge (Room 112).",
      "mode": "view"
    },
    {
      "name": "view-bookings",
      "title": "View Bookings",
      "description": "View upcoming IBP Lounge bookings.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "name",
      "title": "Full Name",
      "description": "Your full name for booking",
      "type": "textfield",
      "required": true
    },
    {
      "name": "email",
      "title": "Email",
      "description": "Your email address for booking",
      "type": "textfield",
      "required": true
    },
    {
      "name": "studentId",
      "title": "Student ID",
      "description": "Your student ID for booking",
      "type": "textfield",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.18",
    "@raycast/utils": "^1.17.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}